# Local development values. Replace secrets before deploying.
VESTIS_NETWORK=vestis-services
# Isolated mode: the worker waits for tasks in its own Redis.
# With wardrobe: redis://vestis-wardrobe-redis:6379/0
REDIS_URL=redis://ml-redis:6379/0
ML_TASKS_QUEUE=ml_tasks
ML_TASKS_DLQ=ml_tasks_dlq
WARDROBE_PROCESSING_URL=http://outfit_wardrobe_api:8000/items/processing
ML_SERVICE_TOKEN=local-only-ml-callback-token-change-before-deployment
# With wardrobe: http://vestis-wardrobe-minio:9000
MINIO_ENDPOINT=http://ml-minio:9000
MINIO_ACCESS_KEY=vestis
MINIO_SECRET_KEY=local-only-photo-storage-password
MINIO_BUCKET=wardrobe-photos
OPENCLIP_MODEL_NAME=hf-hub:Marqo/marqo-fashionCLIP
OPENCLIP_PRETRAINED=
INFERENCE_DEVICE=cpu
